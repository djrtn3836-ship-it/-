[32m+[m[32m    def _split_periods([m
[32m+[m[32m        self, dates: List[str], mode: str[m
[32m+[m[32m    ) -> List[Tuple[List[str], List[str]]]:[m
[32m+[m[32m        n = len(dates)[m
[32m+[m[32m        train_size = max(self._min_periods, int(n * self._train_ratio))[m
[32m+[m[32m        test_size = max(1, n - train_size)[m
[32m+[m[32m        if train_size + test_size > n:[m
[32m+[m[32m            return [][m
[32m+[m
[32m+[m[32m        folds: List[Tuple[List[str], List[str]]] = [][m
[32m+[m[32m        step = max(1, test_size // 3)[m
[32m+[m[32m        pos = train_size[m
[32m+[m[32m        while pos < n:[m
[32m+[m[32m            test_end = min(pos + step, n)[m
[32m+[m[32m            if mode == "anchored":[m
[32m+[m[32m                train_start = 0[m
