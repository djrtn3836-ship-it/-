[32m+[m[32m                train_start = max(0, pos - train_size)[m
[32m+[m[32m            folds.append((dates[train_start:pos], dates[pos:test_end]))[m
[32m+[m[32m            pos = test_end[m
[32m+[m[32m        return folds[m
