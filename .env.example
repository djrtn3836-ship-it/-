# stock_analyzer V10 — 환경변수 템플릿
# 사용법: 이 파일을 .env 로 복사한 뒤 실제 값을 채우세요.
#   cp .env.example .env
# 인코딩: UTF-8 (BOM 없음) 유지
#
# ⚠️ 아래 4개는 app/bootstrap.py 의 validate_env() 필수 키입니다(없으면 부팅 중단):
#   KIWOOM_APP_KEY, KIWOOM_APP_SECRET, TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID

# ── Kiwoom (키움증권) — 필수 ─────────────────────────────
KIWOOM_APP_KEY=your_kiwoom_app_key
KIWOOM_APP_SECRET=your_kiwoom_app_secret
# (구버전 별칭 KIWOOM_API_KEY / KIWOOM_SECRET_KEY 도 코드가 자동 인식합니다)

# ── Telegram — 필수 (알림 전송) ──────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# ── DART (공시) / NAVER (뉴스 감성) ──────────────────────
DART_API_KEY=your_dart_api_key
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret

# ── 데이터베이스 ─────────────────────────────────────────
# DB_TYPE: sqlite(강제) | postgres(DATABASE_URL 필요) | 미설정 시 자동
#   - 미설정: DATABASE_URL 이 있으면 PostgreSQL, 없으면 SQLite
DB_TYPE=sqlite
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# DATABASE_URL_READ=postgresql://user:password@host:5432/dbname
SQLITE_DB_PATH=data/decisions.db

# ── Redis 캐시 (선택) ────────────────────────────────────
# REDIS_URL=redis://localhost:6379/0

# ── 로깅 ─────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
STRUCTURED_LOGGING=false

# ── 실행 환경 ────────────────────────────────────────────
ENVIRONMENT=production
DEBUG=false

# ── 외부 수집기 ──────────────────────────────────────────
NEWS_CRAWLER_ENABLED=true
MACRO_COLLECTOR_ENABLED=true
YFINANCE_TIMEOUT=10

# ══════════════════════════════════════════════════════════════
#  운영 튜닝 (2026-10-10) — 기본값으로 충분하며 필요 시만 조정
# ══════════════════════════════════════════════════════════════
# 종목당 심층 분석 최소 간격(초). 0이면 매 틱 분석(자원 폭발 주의)
ANALYSIS_MIN_INTERVAL_SEC=300
# 이 변동률(%) 이상이면 간격을 무시하고 즉시 분석(급변 알림 지연 방지)
ANALYSIS_BYPASS_PCT=2.0
# 같은 종목·행동의 알림 재발송 억제(초)
ALERT_COOLDOWN_SEC=1800
#   알림 큐(2026-10-10): 전송을 워커에서 분리 — 실패 시 보관 후 재시도
ALERT_QUEUE_MAX=1000
ALERT_BACKLOG_PATH=logs/pending_alerts.jsonl
ALERT_BACKLOG_MAX=200

#   DB 백업(2026-10-10): 온라인 백업 API + 무결성 검사 + 보관 회전
DB_BACKUP_HOUR=7
BACKUP_DIR=backups
BACKUP_KEEP=7
# 하이퍼파라미터 튜닝 결과 영속화 경로(재기동 시 복원)
TUNING_STATE_PATH=data/tuning_state.json
# 모의매매 측정 기록 경로(실제 주문 없음)
PAPER_SIGNALS_PATH=logs/paper_signals.jsonl
PAPER_SETTLED_PATH=logs/paper_settled.jsonl
# JSONL 기록 파일 회전(크기/보관 개수)
JSONL_MAX_BYTES=20971520
JSONL_BACKUP_COUNT=3
# Supervisor 메모리 알림 임계(MB). 비우면 시스템 RAM의 80% 자동
SUPERVISOR_MEMORY_THRESHOLD_MB=
# Supervisor 알림 재발송 억제(초)
SUPERVISOR_ALERT_COOLDOWN_SEC=1800
# 이상탐지 경고 로그 쿨다운(초)
ANOMALY_LOG_COOLDOWN_SEC=1800
