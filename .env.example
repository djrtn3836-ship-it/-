# stock_analyzer V10 — 환경변수 템플릿
# 사용법: 이 파일을 .env 로 복사한 뒤 실제 값을 채우세요.
#   cp .env.example .env
# 인코딩: UTF-8 (BOM 없음) 유지
#
# ⚠️ 아래 4개는 app/bootstrap.py 의 validate_env() 필수 키입니다(없으면 부팅 중단):
#   KIWOOM_APP_KEY, KIWOOM_APP_SECRET, TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID

# ── Kiwoom (키움증권) — 필수 ─────────────────────────────
KIWOOM_APP_KEY=your_kiwoom_app_key
KIWOOM_APP_SECRET=your_kiwoom_app_secret
# (구버전 별칭 KIWOOM_API_KEY / KIWOOM_SECRET_KEY 도 코드가 자동 인식합니다)

# ── Telegram — 필수 (알림 전송) ──────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# ── DART (공시) / NAVER (뉴스 감성) ──────────────────────
DART_API_KEY=your_dart_api_key
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret

# ── 데이터베이스 ─────────────────────────────────────────
# DB_TYPE: sqlite(강제) | postgres(DATABASE_URL 필요) | 미설정 시 자동
#   - 미설정: DATABASE_URL 이 있으면 PostgreSQL, 없으면 SQLite
DB_TYPE=sqlite
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# DATABASE_URL_READ=postgresql://user:password@host:5432/dbname
SQLITE_DB_PATH=data/decisions.db

# ── Redis 캐시 (선택) ────────────────────────────────────
# REDIS_URL=redis://localhost:6379/0

# ── 로깅 ─────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
STRUCTURED_LOGGING=false

# ── 실행 환경 ────────────────────────────────────────────
ENVIRONMENT=production
DEBUG=false

# ── 외부 수집기 ──────────────────────────────────────────
NEWS_CRAWLER_ENABLED=true
MACRO_COLLECTOR_ENABLED=true
YFINANCE_TIMEOUT=10
